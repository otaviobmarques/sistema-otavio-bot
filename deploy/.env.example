# Otávio Bot no VPS (docs/otavio-bot/VPS-24H.md). Copie para .env e ajuste.
# Nada aqui é segredo: os logins do Claude e do ChatGPT ficam no volume de dados.

# Endereço do servidor. O registro A do DNS deste nome aponta para o IP do VPS.
DOMAIN=bots.seudominio.com.br

# Nome que o app mostra para este servidor (padrão: o próprio DOMAIN).
# OMB_SERVER_NAME=Otávio Bot VPS

# Versão da imagem ghcr.io/otaviobmarques/sistema-otavio-bot: latest (a última
# publicada), um número como 0.2.0 para fixar, ou main (cada push no main).
OTAVIO_BOT_VERSION=latest

# Memória máxima do servidor (o desktop de cada bot é outro contêiner, até 4 GB).
OTAVIO_MEM_LIMIT=3g

# Portas 80/443 já ocupadas por outro proxy (nginx, Traefik...)? Tire o # da
# linha abaixo: o servidor fica só em http://127.0.0.1:18080 e aquele proxy
# encaminha https://DOMAIN para lá.
# COMPOSE_FILE=docker-compose.yml:docker-compose.atras-de-proxy.yml
# OTAVIO_PROXY_PORT=18080
# Proxy rodando dentro de um contêiner (Traefik)? Ele não alcança o 127.0.0.1
# do VPS; use o gateway da rede Docker:
# OTAVIO_PROXY_BIND=172.17.0.1

# Traefik que descobre os sites pelas etiquetas do Docker (como no VPS da
# Hostinger, rede traefik-edge)? Use esta linha no lugar do COMPOSE_FILE acima:
# o Traefik pega o certificado e nenhuma porta fica aberta no VPS.
# COMPOSE_FILE=docker-compose.yml:docker-compose.atras-de-proxy.yml:docker-compose.traefik.yml
# TRAEFIK_NETWORK=traefik-edge
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# Só para quem builda do código (docker compose up -d --build): CLIs embutidas.
# A imagem publicada já traz Claude Code e Codex.
ENGINES=@anthropic-ai/claude-code @openai/codex

# Opcional: entrar com código por e-mail em vez de código de pareamento.
# Endereços ou @dominio, separados por vírgula. Admins têm acesso total;
# membros só conversam e aprovam.
OMB_SIGNIN_EMAILS=
OMB_SIGNIN_MEMBER_EMAILS=

# Opcional: enviar esses códigos pelo seu próprio servidor de e-mail, ex.
# smtps://usuario%40exemplo.com:SENHA@smtp.exemplo.com:465 (docs/self-hosting.md).
OMB_SIGNIN_SMTP_URL=
OMB_SIGNIN_SMTP_FROM=

# Backup diário (deploy/backup.sh): pasta e quantos dias guardar.
BACKUP_DIR=/var/backups/otavio-bot
BACKUP_KEEP_DAYS=14
