# As mesmas do Admin: o gateway lê planos, tokens, preços e chaves de IA do mesmo banco.
# Use a conexão direta (porta 5432) ou o Session pooler do Supabase: o gateway é um processo longo.
DATABASE_URL=
DATABASE_SSL=
ADMIN_ENCRYPTION_KEY=
ADMIN_ENCRYPTION_KEY_PREVIOUS=
GATEWAY_DB_POOL=10

# IA gratuita do plano Inicial: chaves dos planos gratuitos dos provedores (só os nomes aqui; nunca faça commit dos valores).
# Somam-se às chaves de Integrações e só servem os modelos marcados "grátis" em Preços. Sem chave, o provedor é pulado.
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Ordem de tentativa quando um provedor está no limite (429/5xx/sem resposta). Padrão: groq,gemini,nvidia,openrouter
ARKOBOT_FREE_AI_ORDER=
# Modelo de cada provedor (vazio = o da tabela de Preços). No OpenRouter só vale id terminado em :free.
ARKOBOT_FREE_MODEL_GROQ=
ARKOBOT_FREE_MODEL_GEMINI=
ARKOBOT_FREE_MODEL_NVIDIA=
ARKOBOT_FREE_MODEL_OPENROUTER=
ARKOBOT_FREE_MODEL_CEREBRAS=
# Requisições por minuto deste processo a cada provedor (padrões: groq 30, gemini 10, nvidia 40, openrouter 20, cerebras 30).
ARKOBOT_FREE_RPM_GROQ=
ARKOBOT_FREE_RPM_GEMINI=
ARKOBOT_FREE_RPM_NVIDIA=
ARKOBOT_FREE_RPM_OPENROUTER=
ARKOBOT_FREE_RPM_CEREBRAS=
# Espera pelo início da resposta antes de passar ao próximo provedor (ms). Padrão: 30000
ARKOBOT_FREE_TIMEOUT_MS=
