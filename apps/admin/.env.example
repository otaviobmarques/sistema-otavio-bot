# Central de Administrador do ArkoBot — copie para apps/admin/.env (que o git ignora).

# Postgres. Local: postgres://usuario:senha@127.0.0.1:5432/arko_admin
# Supabase (Vercel/serverless): use a URL do "Transaction pooler" (porta 6543).
DATABASE_URL=postgres://arko:arko@127.0.0.1:5432/arko_admin
# off | require | verify. Vazio: off para localhost, require para o resto.
DATABASE_SSL=

# 32 bytes em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cifra chaves do Asaas, tokens de webhook, chaves de IA e segredos das instâncias. NÃO PERCA: sem ela os segredos não abrem.
ADMIN_ENCRYPTION_KEY=
# Só durante uma troca de chave: a anterior, que ainda abre os segredos antigos.
ADMIN_ENCRYPTION_KEY_PREVIOUS=

# 32+ caracteres aleatórios. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Endereço do painel (sem barra no fim). Em produção: https://admin.arkobot.com.br
ADMIN_PUBLIC_URL=http://localhost:5190

# Segredo do cron (GET /api/cron/tick com Authorization: Bearer ...). Na Vercel, defina CRON_SECRET e o cron já o envia.
CRON_SECRET=

# Cabeçalho com o IP real do cliente, preenchido pela borda (na Vercel já é x-real-ip automaticamente).
ADMIN_CLIENT_IP_HEADER=

ADMIN_MAIL_FROM=ArkoBot Admin <admin@arkobot.com.br>

# Régua de inadimplência (dias em atraso).
DUNNING_SUSPEND_AFTER_DAYS=7
DUNNING_CANCEL_AFTER_DAYS=30

# Só desenvolvimento/testes: manda as chamadas do Asaas para um servidor falso.
ASAAS_API_BASE_URL=

# Gateway de IA (processo separado: pnpm --filter admin gateway). Usa DATABASE_URL e ADMIN_ENCRYPTION_KEY acima.
GATEWAY_PORT=8791
# 0.0.0.0 dentro de contêiner; 127.0.0.1 atrás de um proxy no mesmo host.
GATEWAY_HOST=127.0.0.1
# Conexões ao Postgres (cada requisição usa poucas e curtas; streams longos não seguram conexão).
GATEWAY_DB_POOL=10
