# Central de Administrador do ArkoBot — copie para apps/admin/.env (que o git ignora).

# Postgres. Local: postgres://usuario:senha@127.0.0.1:5432/arko_admin
# Supabase (Vercel/serverless): use a URL do "Transaction pooler" (porta 6543).
DATABASE_URL=postgres://arko:arko@127.0.0.1:5432/arko_admin
# off | require | verify. Vazio: off para localhost, require para o resto.
DATABASE_SSL=

# 32 bytes em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cifra chaves do Asaas, tokens de webhook, chaves de IA e segredos das instâncias. NÃO PERCA: sem ela os segredos não abrem.
ADMIN_ENCRYPTION_KEY=
# Só durante uma troca de chave: a anterior, que ainda abre os segredos antigos.
ADMIN_ENCRYPTION_KEY_PREVIOUS=

# 32+ caracteres aleatórios. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Endereço do painel (sem barra no fim). Em produção: https://admin.arkobot.com.br
ADMIN_PUBLIC_URL=http://localhost:5190

# Endereço da Área do cliente (sem barra no fim), servida pelo mesmo deploy e separada pelo host.
# Em produção: https://conta.arkobot.com.br (é o padrão se ficar vazia com NODE_ENV=production).
# Em desenvolvimento: http://localhost:5191 (o pnpm dev abre um segundo Vite nessa porta).
CUSTOMER_PUBLIC_URL=http://localhost:5191
# Remetente dos e-mails da Área do cliente (códigos de acesso).
CUSTOMER_MAIL_FROM=ArkoBot <conta@arkobot.com.br>

# Segredo do cron (GET /api/cron/tick com Authorization: Bearer ...). Na Vercel, defina CRON_SECRET e o cron já o envia.
CRON_SECRET=

# Cabeçalho com o IP real do cliente, preenchido pela borda (na Vercel já é x-real-ip automaticamente).
ADMIN_CLIENT_IP_HEADER=

ADMIN_MAIL_FROM=ArkoBot Admin <admin@arkobot.com.br>
# Chave do Resend (só envio). Vazia: os e-mails vão para o terminal.
RESEND_API_KEY=

# Régua de inadimplência (dias em atraso).
DUNNING_SUSPEND_AFTER_DAYS=7
DUNNING_CANCEL_AFTER_DAYS=30

# Só desenvolvimento/testes: manda as chamadas do Asaas para um servidor falso.
ASAAS_API_BASE_URL=

# Gateway de IA (processo separado: pnpm --filter admin gateway). Usa DATABASE_URL e ADMIN_ENCRYPTION_KEY acima.
GATEWAY_PORT=8791
# 0.0.0.0 dentro de contêiner; 127.0.0.1 atrás de um proxy no mesmo host.
GATEWAY_HOST=127.0.0.1
# Conexões ao Postgres (cada requisição usa poucas e curtas; streams longos não seguram conexão).
GATEWAY_DB_POOL=10
# IA gratuita (plano Inicial): chaves dos planos gratuitos; as demais opções ARKOBOT_FREE_* estão em deploy/gateway.env.example.
# Confira com: pnpm --filter admin ia:testar
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Instâncias dos clientes (provisionamento automático). Vazias = os padrões abaixo.
# Cada instância responde em https://<slug>.<INSTANCES_BASE_DOMAIN> (DNS curinga *.arkobot.com.br -> IP da VPS).
INSTANCES_BASE_DOMAIN=
# Imagem Cloud home do ArkoBot (alvo cloud-home do Dockerfile). Padrão: ghcr.io/otaviobmarques/sistema-otavio-bot-cloud-home:latest
INSTANCE_IMAGE=
# Gateway de IA que as instâncias usam. Padrão: https://ia.arkobot.com.br
AI_GATEWAY_PUBLIC_URL=

# Computadores próprios (VPS). Sem credenciais de um provedor, nada é comprado nele. Nunca no git, nunca no log.
# Hetzner Cloud (padrão): token de um projeto (Console → Security → API tokens, leitura e escrita).
HETZNER_API_TOKEN=
# Hostinger: hPanel → API.
HOSTINGER_API_TOKEN=
# Contabo: Customer Control Panel → API (cliente OAuth e usuário da API).
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
# Chaves SSH públicas do operador, separadas por ";", postas em cada VPS nova.
VPS_SSH_PUBLIC_KEYS=
# Só se as imagens no GHCR forem privadas: login entregue à VPS nova na inscrição (PAT com read:packages).
NODE_REGISTRY_USER=
NODE_REGISTRY_TOKEN=

# Backups diários dos dados dos clientes: um armazenamento compatível com S3 (Contabo Object Storage, Backblaze B2,
# Cloudflare R2, MinIO, AWS). Sem estas quatro, nenhum backup é feito. Nunca no git, nunca no log.
# Ex. Contabo: https://usc1.contabostorage.com (ou eu2…); Backblaze: https://s3.us-west-004.backblazeb2.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Opcionais: prefixo das chaves (padrão arkobot/) e quantos backups diários cada cliente guarda (padrão 7).
BACKUP_S3_PREFIX=
BACKUP_KEEP_DAILY=
